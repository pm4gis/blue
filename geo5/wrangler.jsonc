{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geo5",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/place",
      "/place/"
    ]
  },
  "routes": [
    {
      "pattern": "geo5.pm4gis.nz",
      "custom_domain": true
    }
  ]
}
